# Required
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Recommended: server-only key that bypasses Row Level Security.
# If set, it is used instead of SUPABASE_ANON_KEY. See README "Supabase keys".
SUPABASE_SERVICE_ROLE_KEY=

# Recommended in production: random string Telegram sends with every webhook call,
# so nobody else can post fake updates to your bot endpoint.
TELEGRAM_WEBHOOK_SECRET=

# Optional
GEMINI_MODEL=gemini-3.8-flash
# Tried in order if the main model is overloaded or rate-limited (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# Set to "true" to enable the /demo command. Leave empty in real use.
DEMO_MODE=
# Set to "true" to log (server-side) every extracted fact dropped for lacking a real quote.
DEBUG_EXTRACTION=
